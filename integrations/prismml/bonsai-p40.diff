--- /dev/null
+++ b/ggml/src/ggml-cuda/bonsai-p40/README.md
@@ -0,0 +1,90 @@
+# bonsai-p40 — PQ2_0 decode path for the Tesla P40 (sm_61)
+
+Opt-in specialization of the **batch-1 PQ2_0 mat-vec** for the NVIDIA Tesla P40
+(GP102, `sm_61`). Everything here is guarded by `cc == 610`; on any other GPU
+`bonsai_p40_should_use()` returns false and ggml uses the stock path unchanged.
+
+## Why this exists
+
+The fork has PQ2_0 decode tuning for **GB10** (prefetch + wider block, gated on
+`MMVQ_PARAMETERS_GB10`) and an Ada-tuned 3–8-column kernel
+(`mmvq-pq2_0.cuh`). For Pascal, `get_mmvq_parameters_table()` returns
+`MMVQ_PARAMETERS_GENERIC`, so PQ2_0 decode on a P40 runs the generic
+`mul_mat_vec_q` with `VDR_PQ2_0_Q8_1_MMVQ = 1`.
+
+This kernel is the missing sm_61 case:
+
+| | stock on Pascal | here |
+|---|---|---|
+| output rows per warp | 1 | **4** (4 independent weight streams) |
+| activation loads | per row | **1× per 4 rows** |
+| `+1` code bias | per row | **folded, 1× per chunk** |
+| weight scale `d` | per chunk | hoisted out of the chunk loop |
+| load path | generic | `ld.global.nc` + `prefetch.global.L2` |
+| occupancy | generic table | `__launch_bounds__(256,4)` = 32 warps/SM |
+
+Decode is bandwidth-bound on the P40 (7.21 GB per token / 346 GB/s = 20.8 ms
+floor), so the only lever is memory-level parallelism — which is exactly what
+the four rows per warp buy.
+
+## Files
+
+| file | role |
+|---|---|
+| `bonsai_p40_dispatch.cuh/.cu` | the hook: shape guards + quantise + mat-vec |
+| `gemv_p40.cu` | the kernel (`gemv_pq2_0_p40_kernel`) + the activation quantiser |
+| `pq2_0.h` | PQ2_0 block format and the DP4A core (host **and** device) |
+| `p40_common.h` | P40 constants, `dp4a`, fp16 conversions |
+| `p40_ptx.h` | `ld.global.nc`, `dp4a.u32.s32`, `prefetch.global.L2` |
+| `bonsai_p40.h` | the C API used by the dispatch |
+
+## Hook point
+
+`ggml/src/ggml-cuda/ggml-cuda.cu`, in `ggml_cuda_mul_mat()`, immediately before
+the stock mmvq branch:
+
+```c
+    if (bonsai_p40_should_use(src0->type, cc, ne11) &&
+            bonsai_p40_mul_mat(src0, src1, dst, ctx.stream())) {
+        return;
+    }
+    if (ggml_cuda_should_use_mmvq(src0->type, cc, ne11)) { ... }
+```
+
+`mmvq.cu` itself is deliberately **not** touched: it is heavily templated and
+fused, and a wrong hook there would be hard to review.
+
+## Scope and limits (read before trusting numbers)
+
+* Handles only: `GGML_TYPE_PQ2_0` weights, `src1` F32 with one column, plain 2D
+  MUL_MAT, contiguous rows, `n_in <= 32768` and a multiple of 128. Anything else
+  falls through to the stock path, so correctness for other shapes is
+  unaffected.
+* The GLU-fused call sites (`ggml-cuda.cu` ~line 4125/4218/4286/... call
+  `ggml_cuda_mul_mat_vec_q` directly) bypass `ggml_cuda_mul_mat()` and therefore
+  keep using the stock path. Correct, just not accelerated.
+* The activation scratch is a single lazily `cudaMalloc`ed buffer sized for the
+  model's widest row (32768). One model, one GPU.
+* **Not benchmarked.** Neither a P40 nor `nvcc` was available where this was
+  written, so the speedup versus the stock path is argued from the structure
+  (MLP, folded bias, occupancy), not measured. Use the built-in A/B switch:
+
+  ```bash
+  BONSAI_P40=1 llama-bench -m Ternary-Bonsai-2-27B-PQ2_0.gguf -ngl 99 -fa on -p 0 -n 128
+  BONSAI_P40=0 llama-bench -m Ternary-Bonsai-2-27B-PQ2_0.gguf -ngl 99 -fa on -p 0 -n 128
+  ```
+
+  `BONSAI_P40=0` disables the path at runtime (resolved once, no rebuild).
+
+## Build
+
+Nothing to configure — the CMake glob picks the directory up. Build the CUDA
+backend with `sm_61` in the arch list (it is in the default set):
+
+```bash
+cmake -B build -DGGML_CUDA=ON -DCMAKE_CUDA_ARCHITECTURES=61
+cmake --build build -j
+```
+
+Full background and the verification suite live in the upstream repo this was
+developed in; see `docs/P40_OPTIMIZATION.md` and `docs/INTEGRATION.md` there.
diff --git a/ggml/src/ggml-cuda/bonsai-p40/bonsai_p40.h b/ggml/src/ggml-cuda/bonsai-p40/bonsai_p40.h
new file mode 100644
index 0000000..2146e09
--- /dev/null
+++ b/ggml/src/ggml-cuda/bonsai-p40/bonsai_p40.h
@@ -0,0 +1,53 @@
+// bonsai_p40.h -- public C API of the Bonsai-P40 compute kernels.
+//
+// This library contains ONE forward path: Ternary-Bonsai-2-27B (qwen35) in the
+// PQ2_0 ("q2_0") packing, running on an NVIDIA Tesla P40 (sm_61).  There is no
+// code path for any other model, quantisation, or GPU.
+#pragma once
+
+#include <cstdint>
+#include <cstddef>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Opaque stream handle so the header stays free of CUDA types.
+typedef void * bonsai_stream;
+
+// --- decode (batch = 1) matrix-vector ---------------------------------------
+// y[n_out] = W[n_out, n_in] . x, where W is PQ2_0 and x has already been
+// quantised to the PQ2_0-native Q8_1 layout by bonsai_p40_quant_activations().
+int bonsai_p40_gemv(const void * W, const void * xq, float * y,
+                    int64_t n_out, int64_t n_in, bonsai_stream stream);
+
+// Quantise `n` floats to the permuted Q8_1 activation layout.
+int bonsai_p40_quant_activations(const float * x, void * out, int64_t n, bonsai_stream stream);
+
+// --- prefill (batch > 1) batched matmul -------------------------------------
+// Y[n_out, n_tok] = W[n_out, n_in] . X[n_in, n_tok], X in permuted Q8_1.
+int bonsai_p40_gemm(const void * W, const void * Xq, float * Y,
+                    int64_t n_out, int64_t n_in, int64_t n_tok, bonsai_stream stream);
+
+// --- fused elementwise / transform kernels ----------------------------------
+// Activation Hadamard rotation (block 1024) with an explicit +-1 sign vector.
+int bonsai_p40_fwht(float * x, const float * signs, int64_t n, bonsai_stream stream);
+
+// RMSNorm over rows of length n.
+int bonsai_p40_rmsnorm(const float * x, const float * w, float * y,
+                       int64_t n_rows, int64_t n, float eps, bonsai_stream stream);
+
+// Gated DeltaNet recurrent step for the linear-attention layers (GQA: n_v_heads
+// value heads share n_k_heads key heads).
+int bonsai_p40_gdn_step(float * state, const float * q, const float * k, const float * v,
+                        const float * g, const float * beta, float * out,
+                        int n_k_heads, int n_v_heads, int K, int V, bonsai_stream stream);
+
+// Causal flash attention for the full-attention layers (GQA n_head/n_head_kv).
+int bonsai_p40_attn(const float * q, const float * k, const float * v, float * out,
+                    int n_tok, int n_head, int n_head_kv, int head_dim, float scale,
+                    bonsai_stream stream);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/ggml/src/ggml-cuda/bonsai-p40/bonsai_p40_dispatch.cu b/ggml/src/ggml-cuda/bonsai-p40/bonsai_p40_dispatch.cu
new file mode 100644
index 0000000..4630144
--- /dev/null
+++ b/ggml/src/ggml-cuda/bonsai-p40/bonsai_p40_dispatch.cu
@@ -0,0 +1,108 @@
+// bonsai_p40_dispatch.cu -- see bonsai_p40_dispatch.cuh.
+//
+// Why this is a separate translation unit at all: it lets the P40 path be a
+// drop-in addition.  If anything about the tensor shapes is not exactly what
+// the kernel supports, bonsai_p40_mul_mat() returns false and ggml falls back
+// to the stock mmvq path, so the integration cannot silently produce wrong
+// results for other models or shapes.
+#include "bonsai_p40_dispatch.cuh"
+#include "bonsai_p40.h"
+#include "pq2_0.h"
+#include "p40_common.h"
+#include "p40_dispatch_predicate.h"
+
+#include <cuda_runtime.h>
+#include <cstdio>
+#include <cstdlib>
+
+using namespace bonsai;
+
+namespace {
+
+// The widest row in Ternary-Bonsai-2-27B is feed_forward_length = 17408.
+// P40_MAX_ROW (32768, in p40_dispatch_predicate.h) leaves headroom and costs
+// 32 KiB of scratch.
+constexpr int BONSAI_P40_CC = 610;   // Tesla P40 / GP102, sm_61
+
+// Lazily allocated activation scratch, quantised into the PQ2_0-native layout.
+// One model, one GPU, so a single buffer is enough; no context plumbing needed.
+block_q8_1 * g_scratch = nullptr;
+
+// A/B switch for benchmarking, resolved once so the hot path stays free:
+//   BONSAI_P40=0 llama-bench ...   -> stock path
+//   BONSAI_P40=1 llama-bench ...   -> this kernel (default)
+bool bonsai_p40_enabled() {
+    static const bool enabled = [] {
+        const char * e = std::getenv("BONSAI_P40");
+        return !(e != nullptr && e[0] == '0');
+    }();
+    return enabled;
+}
+
+// BONSAI_P40_VERBOSE=1 prints one line the first time the path takes over, so a
+// workflow can prove the kernel is actually being used.
+bool bonsai_p40_verbose() {
+    static const bool verbose = std::getenv("BONSAI_P40_VERBOSE") != nullptr;
+    return verbose;
+}
+
+} // namespace
+
+bool bonsai_p40_should_use(enum ggml_type type, int cc, int64_t ne11) {
+    if (!bonsai_p40_enabled()) return false;
+    return type == GGML_TYPE_PQ2_0 && cc == BONSAI_P40_CC && ne11 == 1;
+}
+
+bool bonsai_p40_mul_mat(const struct ggml_tensor * src0, const struct ggml_tensor * src1,
+                        struct ggml_tensor * dst, cudaStream_t stream) {
+    if (src0 == nullptr || src1 == nullptr || dst == nullptr) return false;
+
+    // The takeover decision is a pure function of the shapes, and it is
+    // unit-tested on the host (tests: [dispatch] ...).  A wrong "yes" here would
+    // silently corrupt results, so it lives in its own header, not inline.
+    p40_mulmat_shape s{};
+    s.type0 = (int)src0->type;
+    s.type1 = (int)src1->type;
+    s.type2 = (int)dst->type;
+    s.n_in  = src0->ne[0];
+    s.n_out = src0->ne[1];
+    s.ne20  = src0->ne[2];
+    s.ne30  = src0->ne[3];
+    s.ne11  = src1->ne[1];
+    s.ne12  = src1->ne[2];
+    s.ne13  = src1->ne[3];
+    s.dst_ne1 = dst->ne[1];
+    s.nb1   = src0->nb[1];
+    if (!p40_decode_path_ok(s)) return false;
+
+    const int64_t n_in  = s.n_in;
+    const int64_t n_out = s.n_out;
+
+    if (g_scratch == nullptr) {
+        const size_t bytes = (size_t)(P40_MAX_ROW / P40_QK_PQ2_0) * sizeof(block_q8_1);
+        if (cudaMalloc((void **)&g_scratch, bytes) != cudaSuccess) {
+            g_scratch = nullptr;
+            return false;
+        }
+    }
+
+    // 1. activations -> PQ2_0-native Q8_1 layout, 2. mat-vec
+    if (bonsai_p40_quant_activations((const float *)src1->data, g_scratch, n_in,
+                                     (bonsai_stream)stream) != 0) {
+        return false;
+    }
+    if (bonsai_p40_gemv(src0->data, g_scratch, (float *)dst->data, n_out, n_in,
+                        (bonsai_stream)stream) != 0) {
+        return false;
+    }
+    if (bonsai_p40_verbose()) {
+        static bool reported = false;
+        if (!reported) {
+            reported = true;
+            fprintf(stderr, "bonsai-p40: sm_61 PQ2_0 decode path active "
+                            "(n_in=%lld n_out=%lld)\n",
+                    (long long)n_in, (long long)n_out);
+        }
+    }
+    return true;
+}
