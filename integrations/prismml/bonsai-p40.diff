new file mode 100644
index 0000000..2986467
--- /dev/null
+++ b/ggml/src/ggml-cuda/bonsai-p40/p40_common.h
@@ -0,0 +1,148 @@
+// p40_common.h -- shared host/device primitives for the Bonsai-P40 kernel.
+//
+// Everything in this header is compiled both by nvcc (device) and by a plain
+// C++ host compiler (reference + tests).  The numeric core of every kernel is
+// expressed as a BONSAI_HD inline function so the exact same code path that the
+// P40 runs can be validated on the host against a naive dequantised reference.
+//
+// Target: NVIDIA Tesla P40 (GP102, sm_61, 24 GB GDDR5, ~346 GB/s, no tensor
+// cores, FP16 ALU throughput = 1/64 of FP32 -> we never do FP16 math, we use
+// FP32 accumulate + INT8 DP4A, which sm_61 supports).
+#pragma once
+
+#include <cstdint>
+#include <cmath>
+#include <cstring>
+
+#ifdef __CUDACC__
+#define BONSAI_HD __host__ __device__
+#define BONSAI_D  __device__
+#define BONSAI_H  __host__
+#include <cuda_runtime.h>
+#include <cuda_fp16.h>
+#else
+#define BONSAI_HD
+#define BONSAI_D
+#define BONSAI_H
+#endif
+
+namespace bonsai {
+
+// ---------------------------------------------------------------------------
+// Tesla P40 (GP102) constants.  All tuning decisions in this kernel are made
+// against these numbers and nothing else -- the kernel deliberately does not
+// carry generic code paths for other GPUs.
+// ---------------------------------------------------------------------------
+struct p40_spec {
+    static constexpr int    cc                = 61;      // sm_61
+    static constexpr int    sm_count          = 30;      // GP102: 30 SMs
+    static constexpr int    cores_per_sm      = 128;
+    static constexpr int    cores             = 3840;
+    static constexpr int    clock_khz         = 1531000; // boost
+    static constexpr int    threads_per_sm    = 2048;
+    static constexpr int    regs_per_sm       = 65536;
+    static constexpr int    smem_per_sm       = 98304;   // 96 KiB
+    static constexpr int    smem_per_block    = 49152;   // 48 KiB (opt-in)
+    static constexpr int    max_blocks_per_sm = 32;
+    static constexpr int    l2_bytes          = 3u * 1024u * 1024u; // 3 MiB
+    static constexpr double mem_bw_gbs        = 346.0;   // GDDR5 peak
+    static constexpr double fp32_tflops       = 2.0 * cores * clock_khz * 1e3 / 1e12;
+    static constexpr int    has_dp4a          = 1;       // cc >= 610
+};
+
+// ---------------------------------------------------------------------------
+// fp16 <-> fp32.  On device we use the hardware intrinsics; on the host we use
+// a bit-exact software conversion so tests reproduce device rounding.
+// ---------------------------------------------------------------------------
+BONSAI_HD inline float f16_to_f32(uint16_t h) {
+#ifdef __CUDACC__
+    return __half2float(__ushort_as_half(h));
+#else
+    const uint32_t sign = (uint32_t)(h & 0x8000u) << 16;
+    uint32_t exp  = (h >> 10) & 0x1Fu;
+    uint32_t mant =  h & 0x3FFu;
+    uint32_t out;
+    if (exp == 0) {
+        if (mant == 0) { out = sign; }
+        else {                       // subnormal
+            exp = 127 - 15 + 1;
+            while ((mant & 0x400u) == 0) { mant <<= 1; exp--; }
+            mant &= 0x3FFu;
+            out = sign | (exp << 23) | (mant << 13);
+        }
+    } else if (exp == 0x1Fu) {       // inf / nan
+        out = sign | 0x7F800000u | (mant << 13);
+    } else {
+        out = sign | ((exp - 15 + 127) << 23) | (mant << 13);
+    }
+    float f; std::memcpy(&f, &out, sizeof(f)); return f;
+#endif
+}
+
+BONSAI_HD inline uint16_t f32_to_f16(float f) {
+#ifdef __CUDACC__
+    return __half_as_ushort(__float2half(f));
+#else
+    // Host reference conversion.  NOTE: this rounds half-away-from-zero while
+    // the hardware cvt.rn.f16.f32 rounds to nearest-even.  The two differ only
+    // on exact ties, and the decoded values here are PQ2_0 group scales whose
+    // contribution is far below the quantisation noise the tests measure; the
+    // host/device comparison is therefore within tolerance by construction.
+    uint32_t x; std::memcpy(&x, &f, sizeof(x));
+    const uint32_t sign = (x >> 16) & 0x8000u;
+    int32_t  exp  = (int32_t)((x >> 23) & 0xFFu) - 127 + 15;
+    uint32_t mant = x & 0x7FFFFFu;
+    if (((x >> 23) & 0xFFu) == 0xFFu) {                 // inf / nan
+        return (uint16_t)(sign | 0x7C00u | (mant ? 0x200u : 0u));
+    }
+    if (exp >= 0x1F) { return (uint16_t)(sign | 0x7C00u); }        // overflow
+    if (exp <= 0) {                                     // subnormal / zero
+        if (exp < -10) { return (uint16_t)sign; }
+        mant |= 0x800000u;
+        const uint32_t shift = (uint32_t)(14 - exp);
+        uint32_t m = mant >> shift;
+        if (mant & (1u << (shift - 1))) { m += 1; }     // round half up
+        return (uint16_t)(sign | m);
+    }
+    uint32_t m = mant >> 13;
+    if (mant & 0x1000u) {                               // round half up
+        m += 1;
+        if (m == 0x400u) { m = 0; exp += 1; if (exp >= 0x1F) { return (uint16_t)(sign | 0x7C00u); } }
+    }
+    return (uint16_t)(sign | ((uint32_t)exp << 10) | m);
+#endif
+}
+
+// A "half" stored as raw bits, used to lay out the GGUF blocks on the host.
+struct hbits { uint16_t v; };
+
+BONSAI_HD inline int dp4a(int a, int b, int c) {
+#ifdef __CUDACC__
+#if __CUDA_ARCH__ >= 610
+    return __dp4a(a, b, c);
+#else
+    int r = c;
+    for (int i = 0; i < 4; ++i) {
+        const int ai = (a >> (8 * i)) & 0xFF; const int bi = (b >> (8 * i)) & 0xFF;
+        r += (int8_t)ai * (int8_t)bi;
+    }
+    return r;
+#endif
+#else
+    // Host emulation of __dp4a: four signed byte products.
+    int r = c;
+    for (int i = 0; i < 4; ++i) {
+        const int8_t ai = (int8_t)((a >> (8 * i)) & 0xFF);
+        const int8_t bi = (int8_t)((b >> (8 * i)) & 0xFF);
+        r += (int)ai * (int)bi;
+    }
+    return r;
+#endif
+}
+
+// Sum of the four signed bytes of a packed int (used to fold the PQ2_0 +1 bias).
+BONSAI_HD inline int dp4a_sum(int a) {
+    return dp4a(a, 0x01010101, 0);
+}
+
+} // namespace bonsai
diff --git a/ggml/src/ggml-cuda/bonsai-p40/p40_dispatch_predicate.h b/ggml/src/ggml-cuda/bonsai-p40/p40_dispatch_predicate.h
new file mode 100644
index 0000000..435dfbb
--- /dev/null
+++ b/ggml/src/ggml-cuda/bonsai-p40/p40_dispatch_predicate.h
@@ -0,0 +1,49 @@
+// p40_dispatch_predicate.h -- the ONLY decision that lets the P40 kernel take
+// over a MUL_MAT, kept free of ggml and CUDA types so it can be unit-tested.
+//
+// This is the safety-critical part of the PrismML integration: if it says yes
+// for a shape the kernel does not implement, results are silently wrong; if it
+// says no, ggml just falls through to the stock path.  Hence: pure C++,
+// exhaustively tested (see tests/test_p40.cpp, section 11).
+#pragma once
+
+#include <cstdint>
+
+namespace bonsai {
+
+// Numeric values of the ggml_type enum we care about (ggml.h; stable ABI).
+static constexpr int P40_GGML_TYPE_F32   = 0;
+static constexpr int P40_GGML_TYPE_PQ2_0 = 142;
+
+// Geometry the kernel actually supports.
+static constexpr int P40_QK_PQ2_0        = 128;   // weights per PQ2_0 block
+static constexpr int P40_BLOCK_PQ2_0_BYTES = 34;  // fp16 d + 32 code bytes
+static constexpr int P40_MAX_ROW         = 32768; // widest row we allocate scratch for
+
+// Everything the predicate needs, as plain numbers.
+struct p40_mulmat_shape {
+    int     type0, type1, type2;   // src0, src1, dst ggml types
+    int64_t n_in, n_out;           // src0->ne[0], src0->ne[1]
+    int64_t ne20, ne30;            // src0->ne[2], src0->ne[3]
+    int64_t ne11, ne12, ne13;      // src1->ne[1..3]
+    int64_t dst_ne1;               // dst->ne[1]
+    int64_t nb1;                   // src0->nb[1] (row stride in bytes)
+};
+
+inline bool p40_decode_path_ok(const p40_mulmat_shape & s) {
+    if (s.type0 != P40_GGML_TYPE_PQ2_0) return false;
+    if (s.type1 != P40_GGML_TYPE_F32 || s.type2 != P40_GGML_TYPE_F32) return false;
+    // plain 2D MUL_MAT, one output column (decode)
+    if (s.ne20 != 1 || s.ne30 != 1) return false;
+    if (s.ne11 != 1 || s.ne12 != 1 || s.ne13 != 1) return false;
+    if (s.dst_ne1 != 1) return false;
+    // dimensions the kernel handles
+    if (s.n_in <= 0 || s.n_out <= 0) return false;
+    if (s.n_in % P40_QK_PQ2_0 != 0) return false;
+    if (s.n_in > P40_MAX_ROW) return false;
+    // rows must be a contiguous run of PQ2_0 blocks
+    if (s.nb1 != (s.n_in / P40_QK_PQ2_0) * P40_BLOCK_PQ2_0_BYTES) return false;
+    return true;
+}
+
+} // namespace bonsai
diff --git a/ggml/src/ggml-cuda/bonsai-p40/p40_ptx.h b/ggml/src/ggml-cuda/bonsai-p40/p40_ptx.h
new file mode 100644
index 0000000..e675452
--- /dev/null
+++ b/ggml/src/ggml-cuda/bonsai-p40/p40_ptx.h
@@ -0,0 +1,71 @@
+// p40_ptx.h -- the few places where hand-written PTX beats what nvcc emits for
+// the P40, plus the reasoning for what is deliberately NOT done in PTX.
+//
+// WHY THIS FILE IS SMALL
+// ----------------------
+// The decode kernel is bandwidth-bound: 7.2 GB per token / 346 GB/s = 20.8 ms,
+// while the entire token costs only ~0.45 G warp-instructions, i.e. ~1-2 ms of
+// issue on 30 SMs x 4 schedulers.  Instruction count therefore does not set the
+// tok/s number, so replacing arithmetic with PTX buys nothing.  What DOES
+// matter is the memory path (cache policy, load width, request coalescing) and
+// occupancy (register pressure -> warps in flight -> latency hiding).
+//
+// So only three things are hand-written:
+//   1. read-only loads (ld.global.nc) for the weights and activations, which
+//      are strictly read-only for the kernel's lifetime;
+//   2. an explicit dp4a.u32.s32, because the weight operand is an *unsigned*
+//      byte (0..3) while the activation operand is signed -- nvcc has to guess,
+//      and stating it removes any sign-extension ambiguity;
+//   3. an L2 prefetch to keep the weight stream ahead of the consumers.
+//
+// Everything else (cvt.f32.f16 for the scales, shfl.sync reductions, the
+// dp4a-based code extraction) is already emitted optimally by nvcc, and adding
+// PTX for it would only add risk.
+#pragma once
+
+#include "p40_common.h"
+
+namespace bonsai {
+
+// --- 1. read-only 16-bit load through the non-coherent (texture) path -------
+// Used for the PQ2_0 code words and the fp16 scales.  The pointers are 2-byte
+// aligned by construction (block_pq2_0 is a 34-byte struct), so we must never
+// widen this to a 32-bit load.
+BONSAI_HD inline uint16_t p40_ldg_u16(const uint16_t * p) {
+#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ >= 320
+    uint16_t v;
+    asm("ld.global.nc.u16 %0, [%1];" : "=h"(v) : "l"(p));
+    return v;
+#else
+    return *p;
+#endif
+}
+
+// Two adjacent uint16 (one 16-code word) as a uint32.
+BONSAI_HD inline uint32_t p40_ldg_u16x2(const uint16_t * p) {
+    return (uint32_t)p40_ldg_u16(p) | ((uint32_t)p40_ldg_u16(p + 1) << 16);
+}
+
+// --- 2. explicit mixed-signedness dp4a -------------------------------------
+// `w` holds four unsigned 2-bit codes (0..3); `a` holds four signed int8
+// activations.  dp4a.u32.s32 states exactly that.
+BONSAI_HD inline int p40_dp4a_us(uint32_t w, int a, int c) {
+#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ >= 610
+    int r;
+    asm("dp4a.u32.s32 %0, %1, %2, %3;" : "=r"(r) : "r"(w), "r"(a), "r"(c));
+    return r;
+#else
+    return dp4a((int)w, a, c);   // host reference / pre-sm61 fallback
+#endif
+}
+
+// --- 3. L2 prefetch for the streaming weight reads -------------------------
+BONSAI_HD inline void p40_prefetch_l2(const void * p) {
+#if defined(__CUDA_ARCH__) && __CUDA_ARCH__ >= 200
+    asm volatile("prefetch.global.L2 [%0];" :: "l"(p));
+#else
+    (void)p;
+#endif
+}
+
+} // namespace bonsai
\ No newline at end of file
diff --git a/ggml/src/ggml-cuda/bonsai-p40/pq2_0.h b/ggml/src/ggml-cuda/bonsai-p40/pq2_0.h
new file mode 100644
index 0000000..a9ee82c
--- /dev/null
+++ b/ggml/src/ggml-cuda/bonsai-p40/pq2_0.h
@@ -0,0 +1,193 @@
+// pq2_0.h -- the "q2_0" weight format of Ternary-Bonsai-2-27B and its numeric
+// core, shared verbatim between the host reference/tests and the P40 kernels.
+//
+// The shipped GGUF file is the PQ2_0 packing (GGML_TYPE_PQ2_0 = 142):
+//
+//   block_pq2_0 : 128 weights, 2-bit codes, one fp16 scale per 128.
+//   code c in {0,1,2,3}  ->  value = (c - 1) * d   (dequantize_row_pq2_0)
+//   element j lives in byte j/4, bits (j%4)*2, little endian.
+//
+// The checkpoint is ternary, so only codes {0,1,2} actually occur; the kernel
+// still handles code 3 because the format (and the reference quantiser) can
+// produce it and the dequantiser maps it to +2.
+//
+// Group size 128, so block size = 2 (fp16 d) + 32 (codes) = 34 bytes.
+#pragma once
+
+#include "p40_common.h"
+
+namespace bonsai {
+
+// ---------------------------------------------------------------------------
+// Block geometry.
+//
+// These are BONSAI_-prefixed ON PURPOSE.  The PrismML fork's ggml-common.h
+// #defines QK_PQ2_0 / QK8_1 / QK8_0 as macros, so a plain `QK8_1` here would be
+// textually replaced and turn `static constexpr int QK8_1 = 32;` into
+// `static constexpr int 32 = 32;`.  Where the fork is present we *inherit* its
+// values instead of duplicating them, so they cannot drift apart.
+// (checked by tools/check_macro_collisions.py)
+// ---------------------------------------------------------------------------
+#ifdef QK_PQ2_0
+static constexpr int BONSAI_QK_PQ2_0 = QK_PQ2_0;     // inherit ggml's value
+#else
+static constexpr int BONSAI_QK_PQ2_0 = 128;          // weights per block
+#endif
+
+#ifdef QK8_1
+static constexpr int BONSAI_QK8_1 = QK8_1;           // inherit ggml's value
+#else
+static constexpr int BONSAI_QK8_1 = 32;              // elements per q8_1 block
+#endif
+
+static constexpr int BONSAI_QI_PQ2_0 = BONSAI_QK_PQ2_0 / 32;   // 4 code chunks per block
+
+struct block_pq2_0 {                             // 34 bytes, 2-byte aligned
+    uint16_t d;                                  // fp16 group scale
+    uint8_t  qs[BONSAI_QK_PQ2_0 / 4];                   // 32 bytes = 128 * 2 bit
+};
+
+struct block_q8_1 {                              // 36 bytes
+    uint16_t d;                                  // fp16 scale
+    uint16_t s;                                  // fp16 bits holding int16 sum(q)
+    int8_t   qs[BONSAI_QK8_1];
+};
+
+BONSAI_HD inline float pq2_0_value(const block_pq2_0 * b, int j) {
+    const int code = (b->qs[j >> 2] >> ((j & 3) * 2)) & 0x03;
+    return (float)(code - 1) * f16_to_f32(b->d);
+}
+
+// Reference dequantiser -- mirrors dequantize_row_pq2_0() in the PrismML fork.
+inline void dequantize_row_pq2_0(const block_pq2_0 * x, float * y, int64_t k) {
+    const int64_t nb = k / BONSAI_QK_PQ2_0;
+    for (int64_t i = 0; i < nb; ++i) {
+        const float d = f16_to_f32(x[i].d);
+        for (int j = 0; j < BONSAI_QK_PQ2_0; ++j) {
+            const int code = (x[i].qs[j >> 2] >> ((j & 3) * 2)) & 0x03;
+            y[i * BONSAI_QK_PQ2_0 + j] = (float)(code - 1) * d;
+        }
+    }
+}
+
+// Reference quantiser -- mirrors quantize_row_pq2_0_ref().
+inline void quantize_row_pq2_0(const float * x, block_pq2_0 * y, int64_t k) {
+    const int64_t nb = k / BONSAI_QK_PQ2_0;
+    for (int64_t i = 0; i < nb; ++i) {
+        float amax = 0.0f;
+        for (int j = 0; j < BONSAI_QK_PQ2_0; ++j) amax = fmaxf(amax, fabsf(x[i * BONSAI_QK_PQ2_0 + j]));
+        const float d  = amax;
+        const float id = d > 0.0f ? 1.0f / d : 0.0f;
+        y[i].d = f32_to_f16(d);
+        for (int j = 0; j < BONSAI_QK_PQ2_0 / 4; ++j) y[i].qs[j] = 0;
+        for (int j = 0; j < BONSAI_QK_PQ2_0; ++j) {
+            int q = (int)lroundf(x[i * BONSAI_QK_PQ2_0 + j] * id) + 1;
+            if (q < 0) { q = 0; }
+            if (q > 3) { q = 3; }
+            y[i].qs[j >> 2] |= (uint8_t)(q << ((j & 3) * 2));
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Activation quantiser.  `permute = false` gives the plain Q8_1 layout;
+// `permute = true` gives the PQ2_0-native layout used by the device kernels:
+// inside every 32-element chunk the four int32 words are transposed so that
+// word k holds elements {k, k+4, k+8, k+12}.  This lets the kernel pair the
+// extracted 2-bit codes with activation bytes without any per-weight shuffle.
+// ---------------------------------------------------------------------------
+inline void quantize_row_q8_1(const float * x, block_q8_1 * y, int64_t k, bool permute) {
+    const int64_t nb = k / BONSAI_QK8_1;
+    for (int64_t i = 0; i < nb; ++i) {
+        float amax = 0.0f;
+        for (int j = 0; j < BONSAI_QK8_1; ++j) amax = fmaxf(amax, fabsf(x[i * BONSAI_QK8_1 + j]));
+        const float d  = amax / 127.0f;
+        const float id = d > 0.0f ? 1.0f / d : 0.0f;
+        int sum = 0;
+        int8_t q[BONSAI_QK8_1];
+        for (int j = 0; j < BONSAI_QK8_1; ++j) {
+            int v = (int)lroundf(x[i * BONSAI_QK8_1 + j] * id);
+            if (v < -127) { v = -127; }
+            if (v > 127)  { v = 127; }
+            q[j] = (int8_t)v; sum += v;
+        }
+        y[i].d = f32_to_f16(d);
+        // `s` carries the raw int16 activation sum in its bit pattern (the
+        // PQ2_0 kernels read it back as int16, never as a float).
+        y[i].s = (uint16_t)(int16_t)sum;
+        // Transposed 4x4 layout inside each 16-element half: position j holds
+        // element 16*(j>>4) + 4*(j&3) + ((j>>2)&3), so the kernel's extracted
+        // 2-bit code word k lines up byte-for-byte with activation word k.
+        for (int j = 0; j < BONSAI_QK8_1; ++j) {
+            const int src = 16 * (j >> 4) + 4 * (j & 3) + ((j >> 2) & 3);
+            y[i].qs[j] = q[permute ? src : j];
+        }
+    }
+}
+
+BONSAI_HD inline int q8_1_sum(const block_q8_1 * a) { return (int16_t)a->s; }
+
+// ---------------------------------------------------------------------------
+// Naive float dot of one PQ2_0 block against 128 float activations.  This is
+// the definition every kernel must reproduce.
+// ---------------------------------------------------------------------------
+inline float pq2_0_dot_f32(const block_pq2_0 * w, const float * a) {
+    const float d = f16_to_f32(w->d);
+    float acc = 0.0f;
+    for (int j = 0; j < BONSAI_QK_PQ2_0; ++j) {
+        const int code = (w->qs[j >> 2] >> ((j & 3) * 2)) & 0x03;
+        acc += (float)(code - 1) * a[j];
+    }
+    return acc * d;
+}
+
+// ---------------------------------------------------------------------------
+// Integer DP4A dot of one PQ2_0 block against the single Q8_1 activation block
+// that covers chunk `iqs` (32 activations).  This is the exact inner body of
+// both device kernels: the GEMV passes agroup[iqs], the GEMM passes the staged
+// shared-memory block directly.
+BONSAI_HD inline float pq2_0_dot_q8_1_block(const block_pq2_0 * w,
+                                            const block_q8_1 * a,
+                                            int iqs) {
+    const uint8_t * qs = w->qs + iqs * 8;     // 8 code bytes = 32 elements
+    const int8_t  * as = a->qs;               // 32 activations
+    int sumi = 0;
+    for (int word = 0; word < 2; ++word) {
+        uint32_t wv; std::memcpy(&wv, qs + word * 4, 4);
+        int av[4]; std::memcpy(av, as + word * 16, 16);
+        // t[k] holds codes {k, k+4, k+8, k+12} of this 16-code word as bytes.
+        const int t0 = (int)((wv >> 0) & 0x03030303u);
+        const int t1 = (int)((wv >> 2) & 0x03030303u);
+        const int t2 = (int)((wv >> 4) & 0x03030303u);
+        const int t3 = (int)((wv >> 6) & 0x03030303u);
+        sumi = dp4a(t0, av[0], sumi);
+        sumi = dp4a(t1, av[1], sumi);
+        sumi = dp4a(t2, av[2], sumi);
+        sumi = dp4a(t3, av[3], sumi);
+    }
+    // value = code - 1  =>  sum((c-1)*a) = sum(c*a) - sum(a)
+    sumi -= q8_1_sum(a);
+    const float d = f16_to_f32(w->d) * f16_to_f32(a->d);
+    return d * (float)sumi;
+}
+
+// Group form: `agroup` points at the four contiguous activation blocks of one
+// weight block (the GEMV layout, one token).
+BONSAI_HD inline float pq2_0_dot_q8_1_perm(const block_pq2_0 * w,
+                                           const block_q8_1 * agroup,
+                                           int iqs) {
+    return pq2_0_dot_q8_1_block(w, agroup + iqs, iqs);
+}
+
+// Whole-row dot: `n` must be a multiple of BONSAI_QK_PQ2_0.
+inline float pq2_0_row_dot_perm(const block_pq2_0 * w, const block_q8_1 * a, int n) {
+    float acc = 0.0f;
+    for (int i = 0; i < n / BONSAI_QK_PQ2_0; ++i) {
+        const block_pq2_0 * wb = w + i;
+        const block_q8_1  * ab = a + i * BONSAI_QI_PQ2_0;
+        for (int iqs = 0; iqs < BONSAI_QI_PQ2_0; ++iqs) acc += pq2_0_dot_q8_1_perm(wb, ab, iqs);
+    }
+    return acc;
+}
+
+} // namespace bonsai
